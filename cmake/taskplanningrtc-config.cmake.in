# TaskPlanningRTC CMake config file
#
# This file sets the following variables:
# TaskPlanningRTC_FOUND - Always TRUE.
# TaskPlanningRTC_INCLUDE_DIRS - Directories containing the TaskPlanningRTC include files.
# TaskPlanningRTC_IDL_DIRS - Directories containing the TaskPlanningRTC IDL files.
# TaskPlanningRTC_LIBRARIES - Libraries needed to use TaskPlanningRTC.
# TaskPlanningRTC_DEFINITIONS - Compiler flags for TaskPlanningRTC.
# TaskPlanningRTC_VERSION - The version of TaskPlanningRTC found.
# TaskPlanningRTC_VERSION_MAJOR - The major version of TaskPlanningRTC found.
# TaskPlanningRTC_VERSION_MINOR - The minor version of TaskPlanningRTC found.
# TaskPlanningRTC_VERSION_REVISION - The revision version of TaskPlanningRTC found.
# TaskPlanningRTC_VERSION_CANDIDATE - The candidate version of TaskPlanningRTC found.

message(STATUS "Found TaskPlanningRTC-@PROJECT_VERSION@")
set(TaskPlanningRTC_FOUND TRUE)

find_package(<dependency> REQUIRED)

#set(TaskPlanningRTC_INCLUDE_DIRS
#    "@CMAKE_INSTALL_PREFIX@/include/@PROJECT_NAME_LOWER@-@PROJECT_VERSION_MAJOR@"
#    ${<dependency>_INCLUDE_DIRS}
#    )
#
#set(TaskPlanningRTC_IDL_DIRS
#    "@CMAKE_INSTALL_PREFIX@/include/@PROJECT_NAME_LOWER@-@PROJECT_VERSION_MAJOR@/idl")
set(TaskPlanningRTC_INCLUDE_DIRS
    "@CMAKE_INSTALL_PREFIX@/include/@CPACK_PACKAGE_FILE_NAME@"
    ${<dependency>_INCLUDE_DIRS}
    )
set(TaskPlanningRTC_IDL_DIRS
    "@CMAKE_INSTALL_PREFIX@/include/@CPACK_PACKAGE_FILE_NAME@/idl")


if(WIN32)
    set(TaskPlanningRTC_LIBRARIES
        "@CMAKE_INSTALL_PREFIX@/@LIB_INSTALL_DIR@/@CMAKE_SHARED_LIBRARY_PREFIX@@PROJECT_NAME_LOWER@@CMAKE_STATIC_LIBRARY_SUFFIX@"
        ${<dependency>_LIBRARIES}
        )
else(WIN32)
    set(TaskPlanningRTC_LIBRARIES
        "@CMAKE_INSTALL_PREFIX@/@LIB_INSTALL_DIR@/@CMAKE_SHARED_LIBRARY_PREFIX@@PROJECT_NAME_LOWER@@CMAKE_SHARED_LIBRARY_SUFFIX@"
        ${<dependency>_LIBRARIES}
        )
endif(WIN32)

set(TaskPlanningRTC_DEFINITIONS ${<dependency>_DEFINITIONS})

set(TaskPlanningRTC_VERSION @PROJECT_VERSION@)
set(TaskPlanningRTC_VERSION_MAJOR @PROJECT_VERSION_MAJOR@)
set(TaskPlanningRTC_VERSION_MINOR @PROJECT_VERSION_MINOR@)
set(TaskPlanningRTC_VERSION_REVISION @PROJECT_VERSION_REVISION@)
set(TaskPlanningRTC_VERSION_CANDIDATE @PROJECT_VERSION_CANDIDATE@)

